---
// Decorative stickers. Always aria-hidden; the page reads the same without them.
//   kind: sparkle | star | squiggle | badge | bolt
interface Props {
  kind: 'sparkle' | 'star' | 'squiggle' | 'badge' | 'bolt';
  color?: string;
  class?: string;
  style?: string;
}
const { kind, color = 'currentColor', class: cls, style } = Astro.props;
const id = `badge-${Math.random().toString(36).slice(2, 8)}`;
---
<span class:list={['sticker', `sticker--${kind}`, cls]} style={style} aria-hidden="true" data-sticker>
  {kind === 'sparkle' && (
    <svg viewBox="0 0 24 24"><path fill={color} d="M12 0c.9 6.4 5.6 11.1 12 12-6.4.9-11.1 5.6-12 12-.9-6.4-5.6-11.1-12-12C6.4 11.1 11.1 6.4 12 0z" /></svg>
  )}
  {kind === 'star' && (
    <svg viewBox="0 0 24 24"><path fill={color} stroke="#0e1a2b" stroke-width="1.6" stroke-linejoin="round" d="M12 1.8l3.1 6.6 7.1.8-5.3 4.9 1.5 7-6.4-3.6-6.4 3.6 1.5-7L1.8 9.2l7.1-.8z" /></svg>
  )}
  {kind === 'bolt' && (
    <svg viewBox="0 0 24 24"><path fill={color} stroke="#0e1a2b" stroke-width="1.6" stroke-linejoin="round" d="M13.5 1.5L4 13.5h6.5l-1.5 9 10-12.5h-6.8z" /></svg>
  )}
  {kind === 'squiggle' && (
    <svg viewBox="0 0 64 64">
      <path fill="none" stroke="#0e1a2b" stroke-width="13" stroke-linecap="round" d="M14 12c18-6 30 2 22 10S10 28 18 38s30 2 30 12-18 10-28 6" />
      <path fill="none" stroke={color} stroke-width="8" stroke-linecap="round" d="M14 12c18-6 30 2 22 10S10 28 18 38s30 2 30 12-18 10-28 6" />
    </svg>
  )}
  {kind === 'badge' && (
    <svg viewBox="0 0 120 120">
      <circle cx="60" cy="60" r="58" fill="#9c8cff" stroke="#0e1a2b" stroke-width="3" />
      <circle cx="60" cy="60" r="30" fill="#d7ec4a" stroke="#0e1a2b" stroke-width="3" />
      <path fill="#0e1a2b" d="M63 42L50 63h9l-2 15 13-21h-9z" />
      <defs><path id={id} d="M60 60m-43 0a43 43 0 1 1 86 0a43 43 0 1 1-86 0" /></defs>
      <g class="sticker__ring">
        <text font-family="JB Mono, monospace" font-size="9" letter-spacing="1.3" fill="#0e1a2b">
          <textPath href={`#${id}`}>SIMPLICITY • USABILITY • JAKARTA • </textPath>
        </text>
      </g>
    </svg>
  )}
</span>
