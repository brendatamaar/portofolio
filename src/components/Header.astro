---
import { site } from '../data/site';
import type { Current } from '../layouts/Base.astro';
interface Props {
  current: Current;
  progress?: boolean;
}
const { current, progress } = Astro.props;
const links = [
  { label: 'Work', href: '/#work', key: 'work' },
  { label: 'Blog', href: '/blog/', key: 'blog' },
  { label: 'About', href: '/#about', key: 'about' },
];
---
<header class="frame">
  <a class="frame__mark" href="/" aria-current={current === 'home' ? 'page' : undefined}>
    <span class="frame__mark-short" aria-hidden="true">{site.short}</span>
    <span class="frame__mark-full">{site.name}</span>
  </a>
  <span class="frame__visit mono" transition:persist="visit" aria-hidden="true">
    <span class="frame__pending" data-pending></span>
    <span data-visit>connected</span>
  </span>
  <nav class="frame__nav" aria-label="Main">
    <ul>
      {links.map((l) => (
        <li>
          <a class="nav-link" href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
        </li>
      ))}
      <li><a class="nav-link" href={`mailto:${site.email}`}>Email</a></li>
    </ul>
  </nav>
  {progress && <span class="frame__progress" aria-hidden="true"><span data-progress></span></span>}
</header>
