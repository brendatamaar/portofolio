---
import { site } from '../data/site';
import Logo from './Logo.astro';
import type { Current } from '../layouts/Base.astro';
interface Props {
  current: Current;
  progress?: boolean;
}
const { current, progress } = Astro.props;
const links = [
  { label: 'Work', href: '/#work', key: 'work' },
  { label: 'Blog', href: '/blog/', key: 'blog' },
  { label: 'About', href: '/#about', key: 'about' },
];
---
<header class="nav">
  <div class="nav__bar">
    <a class="nav__brand" href="/" aria-current={current === 'home' ? 'page' : undefined}>
      <Logo />
      <span class="nav__word">Brendatama</span>
      <span class="sr-only"> Akbar, home</span>
    </a>
    <nav class="nav__links" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a class="nav-link" href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="pill pill--light nav__cta" href={`mailto:${site.email}`}><span>Email me</span><span class="pill__arrow" aria-hidden="true">→</span></a>
    {progress && <span class="nav__progress" aria-hidden="true"><span data-progress></span></span>}
  </div>
</header>
