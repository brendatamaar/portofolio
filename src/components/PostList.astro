---
import { type Post, isoDate, minutes } from '../lib/posts';
interface Props {
  posts: Post[];
  headingLevel?: 2 | 3;
}
const { posts, headingLevel = 2 } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3';
const tones = ['orange', 'lavender', 'green', 'coral', 'lime', 'navy'] as const;
---
<ol class="posts">
  {posts.map((post, i) => (
    <li data-reveal="up" data-delay={String((i % 2) * 0.06)}>
      <a class={`post-card card--${tones[i % tones.length]} bite`} href={`/blog/${post.id}/`}>
        <span class="post-card__meta"><time datetime={post.data.date.toISOString()}>{isoDate(post.data.date)}</time>, {minutes(post)} min read</span>
        <H class="post-card__title">{post.data.title}</H>
        <p class="post-card__desc">{post.data.description}</p>
        <span class="bite__btn" aria-hidden="true">↗</span>
      </a>
    </li>
  ))}
</ol>
