---
// The work list as a waterfall of years: each project is a request that ran for as long as the
// project did. The last row is the one still open.
import { projects, timeline, site } from '../data/site';
const span = timeline.to - timeline.from;
const years = Array.from({ length: span }, (_, i) => timeline.from + i);
const pos = (y: number) => ((y - timeline.from) / span).toFixed(4);
---
<section class="work" id="work" aria-labelledby="work-title">
  <div class="work__head">
    <h2 id="work-title" class="section-title" data-split="lines">Work</h2>
    <p class="work__note">Four projects, drawn across the years they ran. Each one opens as a case study.</p>
  </div>
  <div class="work__axis" aria-hidden="true">
    {years.map((y) => <span class="mono" style={`--x:${pos(y)}`}>{y}</span>)}
  </div>
  <ol class="work__list" data-work>
    {projects.map((p) => (
      <li class="row">
        <a class="row__link" href={`/work/${p.slug}/`}>
          <span class="row__title"><span>{p.title}</span></span>
          <span class="row__meta">
            <span class="row__kind">{p.kind}</span>
            <span class="row__client">{p.client}</span>
          </span>
          <span class="row__track" aria-hidden="true">
            <span class="row__bar" style={`--x:${pos(p.span[0])};--w:${(Number(pos(p.span[1])) - Number(pos(p.span[0]))).toFixed(4)}`}>
              <span class="row__fill"></span>
            </span>
            <span class="row__year mono" style={`--x:${pos(p.span[1])}`}>{p.year}</span>
          </span>
          <span class="row__line" aria-hidden="true"></span>
        </a>
      </li>
    ))}
    <li class="row row--open">
      <a class="row__link" href={`mailto:${site.email}`}>
        <span class="row__title"><span>Your project</span></span>
        <span class="row__meta">
          <span class="row__kind">Pending</span>
          <span class="row__client">{site.availability.split('.')[0]}</span>
        </span>
        <span class="row__track" aria-hidden="true">
          <span class="row__bar row__bar--open" data-pending style={`--x:${pos(2026.8)};--w:${(1 - Number(pos(2026.8))).toFixed(4)}`}>
            <span class="row__fill"></span>
          </span>
        </span>
        <span class="row__line" aria-hidden="true"></span>
      </a>
    </li>
  </ol>
</section>
