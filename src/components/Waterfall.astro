---
// A network waterfall of the page you are on. Rows come from the browser's own Resource Timing
// entries (src/motion/waterfall.ts); nothing here is invented. Without JavaScript it explains itself.
interface Props {
  variant: 'hero' | 'loader';
}
const { variant } = Astro.props;
---
<figure class:list={['wf', `wf--${variant}`]} data-waterfall={variant} aria-hidden={variant === 'loader' ? 'true' : undefined}>
  <table class="wf__table">
    <caption class="sr-only">Requests your browser made to load this page</caption>
    <thead>
      <tr>
        <th scope="col" class="wf__c-name">Name</th>
        <th scope="col" class="wf__c-type">Type</th>
        <th scope="col" class="wf__c-size">Size</th>
        <th scope="col" class="wf__c-time">Time</th>
        <th scope="col" class="wf__c-bar">
          <span class="sr-only">Waterfall</span>
          <span class="wf__axis" aria-hidden="true" data-wf-axis></span>
        </th>
      </tr>
    </thead>
    <tbody data-wf-rows>
      <tr class="wf__empty">
        <td colspan="5">Your browser records every request this page makes. With JavaScript on, they are listed here.</td>
      </tr>
    </tbody>
  </table>
</figure>
