---
import Base from '../../layouts/Base.astro';
import { projects, site, tones } from '../../data/site';

export function getStaticPaths() {
  return projects.map((p, i) => ({
    params: { slug: p.slug },
    props: { project: p, index: i, next: projects[(i + 1) % projects.length] },
  }));
}
const { project: p, index, next } = Astro.props;
const kind = p.type === 'work' ? `Work at ${p.company}` : 'Side project';
const schema = {
  '@context': 'https://schema.org',
  '@type': p.type === 'work' ? 'CreativeWork' : 'SoftwareSourceCode',
  name: p.title,
  abstract: p.summary,
  creator: { '@type': 'Person', name: site.fullName },
  ...(p.link ? { url: p.link.href } : {}),
};
---
<Base title={`${p.title}, ${kind.toLowerCase()}`} description={p.summary.length >= 60 ? p.summary : p.detail} current="work" schema={schema} image={p.img?.src}>
  <article class="case">
    <header class="case__hero">
      <p class="case__kind mono">{kind}</p>
      <h1 class="case__title display" data-split="words" data-intro>{p.title}</h1>
      <p class="case__summary" data-split="lines" data-intro data-delay="0.3">{p.summary}</p>
      <dl class="case__meta" data-reveal="fade" data-intro data-delay="0.5">
        <div><dt>Type</dt><dd>{p.type === 'work' ? 'Work' : 'Side project'}</dd></div>
        <div><dt>{p.type === 'work' ? 'Company' : 'Author'}</dt><dd>{p.company ?? site.name}</dd></div>
        <div class="case__meta-wide"><dt>Stack</dt><dd>{p.stack.join(', ')}</dd></div>
      </dl>
      {p.link && (
        <p class="case__cta" data-reveal="fade" data-intro data-delay="0.6">
          <a class="pill pill--light" href={p.link.href} rel="noopener"><span>{p.link.label}</span><span class="pill__arrow" aria-hidden="true">↗</span></a>
        </p>
      )}
    </header>

    {p.img && (
      <figure class="case__shot" data-reveal="up">
        <img src={p.img.src} width={p.img.width} height={p.img.height} alt={`Screenshot of ${p.title}`} decoding="async" fetchpriority="high" />
      </figure>
    )}

    <section class="case__section case__section--idea" aria-labelledby="about">
      <h2 id="about" class="case__h">About the project</h2>
      <p class="case__text case__text--big" data-split="lines">{p.detail}</p>
    </section>

    <section class="case__section" aria-labelledby="stack">
      <h2 id="stack" class="case__h">Built with</h2>
      <ul class="chips chips--lg case__chips">
        {p.stack.map((s, i) => <li class={`chip chip--${tones[(i + index) % 5]}`}>{s}</li>)}
      </ul>
    </section>

    <nav class="next" aria-label="Next project">
      <a class="next__link" href={`/work/${next.slug}/`}>
        <span class="next__label mono">Next project</span>
        <span class="next__title">{next.title}</span>
        <span class="next__kind">{next.summary}</span>
        <span class="next__track" aria-hidden="true"><span></span></span>
      </a>
    </nav>
  </article>
</Base>
