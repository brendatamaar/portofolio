---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { allPosts, words } from '../../lib/posts';
const posts = await allPosts();
const total = posts.reduce((n, p) => n + words(p), 0);
---
<Base title="Writing" description="Writing by Brendatama Akbar, a web software developer based in Jakarta: what I have been thinking about while building web applications." current="blog">
  <section class="blog-head">
    <h1 class="blog-head__title" data-split="words" data-intro>Writing</h1>
    <p class="blog-head__intro" data-split="lines" data-intro data-delay="0.3">
      What I’ve been thinking about while building web applications.
    </p>
    <p class="blog-head__count mono" data-reveal="fade" data-intro data-delay="0.5">{posts.length} posts, {total.toLocaleString('en-US')} words. <a class="arrow-link" href="/rss.xml"><span>RSS feed</span><span class="arrow" aria-hidden="true">→</span></a></p>
  </section>
  <section class="blog-list" aria-label="All posts">
    <PostList posts={posts} headingLevel={2} />
  </section>
</Base>
