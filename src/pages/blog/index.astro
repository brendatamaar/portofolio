---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { allPosts, words } from '../../lib/posts';
const posts = await allPosts();
const total = posts.reduce((n, p) => n + words(p), 0);
---
<Base title="Blog" description="Writing by Brendatama Akbar on web performance, front end craft and back ends that stay boring to run. Newest first." current="blog">
  <section class="blog-head">
    <h1 class="blog-head__title" data-split="words" data-intro>Blog</h1>
    <p class="blog-head__intro" data-split="lines" data-intro data-delay="0.3">
      Notes from building web applications: how pages load, how data stays where it belongs, and how to keep an interface honest about what the server said.
    </p>
    <p class="blog-head__count mono" data-reveal="fade" data-intro data-delay="0.5">{posts.length} posts, {total.toLocaleString('en-US')} words. <a class="utility" href="/rss.xml">RSS feed</a></p>
  </section>
  <section class="blog-list" aria-label="All posts">
    <PostList posts={posts} full headingLevel={2} />
  </section>
</Base>
